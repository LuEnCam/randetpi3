[Unit]
Description=randnetpi3 - Randnet dial-up answering service
After=network-online.target dnsmasq.service
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/randnetpi3/randnetpi3.py --config /etc/randnetpi3.conf
WorkingDirectory=/opt/randnetpi3

StandardOutput=journal
StandardError=journal

KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
